{
  "manifest_version": 3,
  "name": "MailSync",
  "version": "1.0.0",
  "description": "Seamlessly beams your Android OTPs to your PC clipboard via End-to-End Encryption.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "offscreen",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://mailsync-osb-default-rtdb.asia-southeast1.firebasedatabase.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailSync"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon48.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
