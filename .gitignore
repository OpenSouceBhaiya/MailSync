# ─────────────────────────────────────────────────────────────────────────────
# Gmail OTP Syncer — .gitignore
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: .env files contain real secrets (encryption keys, OAuth secrets,
# API keys). They must NEVER be committed. Only .env.example is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example        # Allow the template; block everything else

# ── Backend ───────────────────────────────────────────────────────────────────
backend/node_modules/
backend/data/        # SQLite database files (may contain decryptable token data)
# SQLite WAL/SHM journal files (created automatically by WAL mode)
*.db
*.db-wal
*.db-shm
# Test databases generated by verification tests
backend/tests/data/

# ── Android ───────────────────────────────────────────────────────────────────
# local.properties contains the local Android SDK path — machine-specific,
# not useful to other developers.
android/local.properties

# Android build outputs (large binary files; reconstructed by building)
android/.gradle/
android/build/
android/app/build/
android/app/release/   # Contains signed APKs — may contain signing key metadata

# Android Studio IDE files (personal IDE settings, not project config)
android/.idea/
*.iml

# Signed APK/AAB bundles (do not commit binaries to git)
*.apk
*.aab

# Android signing keystore (if accidentally placed in project dir)
*.jks
*.keystore
google-services.json

# ── Node.js / npm ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ── OS / Editor noise ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# Public Launch exports
Public Launch/

# Internal agent progress tracker — DO NOT PUSH
progress.md
tree.txt
